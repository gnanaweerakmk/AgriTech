{
  "realm": "agritech",
  "displayName": "AgriTech",
  "loginTheme": "agritech",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "super_admin"
      },
      {
        "name": "auditor"
      },
      {
        "name": "stakeholder"
      },
      {
        "name": "farmer"
      },
      {
        "name": "landowner"
      }
    ]
  },
  "clients": [
    {
      "clientId": "agritech-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-web-client",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/auth/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000"
      },
      "protocolMappers": [
        {
          "name": "AgriTech API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agritech-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agritech-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-api-client",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
